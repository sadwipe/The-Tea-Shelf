<%- include('partials/header') %>

<main>
  <div class="container">
    <h1 class="add-product-header">add a product</h1>
    <form id="add-product" action="/products/new" method="POST">
      <label for="name">Name:</label>
      <input name="name" id="name" type="text" required minlength="3" maxlength="30">
      <label for="quantity">Quantity per bag:</label>
      <input name="quantity" id="quantity" type="number" required min="1">
      <label for="price">Price per bag:</label>
      <input name="price" id="price" type="number" required min="1">
      <label for="stock">Stock:</label>
      <input name="stock" id="stock" type="number" required min="1">
      <label for="image">Image:</label>
      <input type="file" name="src" accept="image/png, image/jpeg, image/svg+xml">
      <button type="submit">Submit</button>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
