<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: "Categories", pageCss: '/css/pages/categories.css' }) %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <div class="container">
      <div class="categories-header">
        <h1>categories</h1>
        <a href="/categories/new">Add a category</a>
      </div>
      <div class="main-content">
        <% if(typeof info !== 'undefined') { %>
          <p style="text-align: center;"><%= info %></p>
        <% } %>
        <div class="categories-list">
          <% categories.forEach(category => { %>
            <a style='background-color: #<%= category.color %>; color: <%= getContrastColor(category.color) %>' class="category-card" href="/categories"><%= category.name %></a>
          <% }) %>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>