<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: "Categories", pageCss: '/css/pages/categories.css' }) %>
</head>
<body>
  <%- include('../partials/header') %>

  <main>
    <div class="container">
      <div class="categories-header">
        <h1>categories</h1>
        <a href="/categories/new">Add a category</a>
      </div>
      <div class="main-content">
        <% if(categories.length === 0) { %>
          <p style="text-align: center;">There are no categories available.</p>
        <% } else { %>
          <div class="categories-list">
            <% categories.forEach(category => { %>
              <a style="background-color: #<%= category.color %>; color: <%= getContrastColor(category.color) %>" href="">
                <%= category.name %>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>