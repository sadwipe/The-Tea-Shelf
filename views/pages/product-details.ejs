<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: product ? product.name : `Product: ${productId}`, pageCss: '/css/pages/product-details.css' }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <main>
    <div class="container">
      <% if (product) { %>
        <a href="/products">&lt;&lt; Return to Products</a>
        <div class="view-product-container">
          <div class="product-content">
            <img src="<%= product.image_url %>" alt="<%= product.name %>">
            <div class="product-text">
              <div class="product-header">
                <h3><%= product.name %></h3>
                <p>$<%= Number(product.price).toFixed(2) %></p>
              </div>
              <p style="background-color: #<%= product.backgroundColor %>; color: <%= getContrastColor(product.backgroundColor) %>" class="product-category">
                <%= product.category %>
              </p>
              <p class="product-quantity">
                Quantity: <%= product.stock %>
              </p>
              <p class="product-description">
                Description: <%= product.description %>
              </p>
            </div>
          </div>
          <div class="product-buttons">
            <form action="/products/edit/<%= product.id %>" method="GET">
              <button id="edit-product-button" type="submit">Edit</button>
            </form>
            <form action="/products/delete/<%= product.id %>" method="POST">
              <button id="delete-product-button" type="submit">Delete</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="not-found-container">
          <h2>Product Not Found</h2>
          <p>Product with ID <%= productId %> doesn't exist.</p>
          <a href="/products">&lt;&lt; Return to Products</a>
        </div>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>