<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: "Search", pageCss: '/css/pages/search-results.css' }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <main>
    <div class="container">
      <h2>
        search results
        <% if (locals.query && locals.query.trim()) { %>
          for '<%= locals.query %>'
        <% } %>
      </h2>
      <a href="/products">&lt&lt Return to Products</a>
      <% if(locals.errors && locals.errors.length !== 0) { %>
        <ul>
          <% locals.errors.map(error => { %>
            <li style="color: red; margin-bottom: 5px;"><%= error.msg %></li>
          <% }) %>
        </ul>
      <% } else { %>
      <div class="products-container">
        <% if(products.length !== 0) { %>
          <% products.forEach(product => { %>
            <a href="/products/<%= product.id %>">
              <div class="product-card">
                <img src="<%= product.image_url %>" class="product-image" alt="<%= product.name %>">
                <div class="card-info">
                  <div class="name-price">
                    <p class="card-name"><%= product.name %></p>
                    <p class="card-price">$<%= Math.round(product.price, 2) %></p>
                  </div>
                  <div class="card-quantity">Quantity: <%= product.stock %>g</div>
                  <div style="background-color: #<%= product.backgroundColor %>; color: <%= getContrastColor(product.backgroundColor) %>" class="product-category"><%= product.category %></div>
                </div>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <p>There are no products.</p>
        <% } %>
      </div>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
